# ============================================================
# HEMOTE VENCIMENTOS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no Git
# ============================================================

# ------------------------------------------------------------
# NEXTAUTH — Autenticação
# Gere com: openssl rand -base64 32
# ------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sua_chave_secreta_aleatoria_aqui

# ------------------------------------------------------------
# AZURE AD (Microsoft Entra ID)
# Setup: portal.azure.com → Azure Active Directory → App registrations
# Redirect URI: https://seu-dominio.vercel.app/api/auth/callback/azure-ad
# ------------------------------------------------------------
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_SECRET=sua_client_secret_aqui
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ------------------------------------------------------------
# TURSO — Banco de Dados SQLite Serverless
# Setup: turso.tech → criar banco → obter URL e token
# ------------------------------------------------------------
TURSO_DATABASE_URL=libsql://seu-banco-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_turso_aqui

# ------------------------------------------------------------
# GOOGLE DRIVE API — Leitura de Arquivos por Agência
# Setup: console.cloud.google.com → credenciais → Service Account
# Baixe o JSON da Service Account e extraia os campos abaixo
# Compartilhe cada pasta do Drive com o email da Service Account
# ------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=hemote-vencimentos@seu-projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------
# MICROSOFT TEAMS — Webhook para Notificações
# Setup: Teams → canal → conectores → Webhook de Entrada
# ------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/seu-webhook-aqui

# ------------------------------------------------------------
# CRON — Segurança do endpoint de cron
# Gere com: openssl rand -base64 32
# Adicione o mesmo valor em Vercel → Settings → Environment Variables
# ------------------------------------------------------------
CRON_SECRET=seu_cron_secret_aqui

# ------------------------------------------------------------
# APP — Configurações Gerais
# ------------------------------------------------------------
# Email da administradora (receberá notificações de solicitação de acesso)
ADMIN_EMAIL=administradora@hemote.gov.br

# Timezone para exibição (não altera o cron, que roda em UTC)
TZ=America/Sao_Paulo
