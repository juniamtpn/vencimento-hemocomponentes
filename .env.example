# ============================================================
# PULSA VENCIMENTOS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no Git
# ============================================================

# ------------------------------------------------------------
# NEXTAUTH — Autenticação
# Gere com: openssl rand -base64 32
# ------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sua_chave_secreta_aleatoria_aqui

# ------------------------------------------------------------
# AZURE AD (Microsoft Entra ID)
# Usado para: login dos usuários + envio de e-mails via Graph API
# Setup: portal.azure.com → App registrations → New registration
# Redirect URI: https://seu-dominio.vercel.app/api/auth/callback/azure-ad
# Permissões necessárias (Application): Mail.Send
# ------------------------------------------------------------
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_SECRET=sua_client_secret_aqui
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ------------------------------------------------------------
# TURSO — Banco de Dados SQLite Serverless
# Setup: turso.tech → criar banco → obter URL e token
# ------------------------------------------------------------
TURSO_DATABASE_URL=libsql://seu-banco-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_turso_aqui

# ------------------------------------------------------------
# GOOGLE DRIVE — Leitura de Arquivos por Agência
# Setup: console.cloud.google.com → APIs & Services → Credentials
#   1. Ative "Google Drive API"
#   2. Crie uma Service Account → gere chave JSON
#   3. Compartilhe a pasta raiz do Drive com o e-mail da Service Account
#   4. Copie o ID da pasta da URL: drive.google.com/drive/folders/ID_AQUI
# ------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@seu-projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_raiz_no_drive

# ------------------------------------------------------------
# MICROSOFT TEAMS — Webhook para Notificações
# Setup: Teams → canal → conectores → Webhook de Entrada
# ------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/seu-webhook-aqui

# ------------------------------------------------------------
# CRON — Segurança do endpoint de cron
# Gere com: openssl rand -base64 32
# Adicione o mesmo valor em Vercel → Settings → Environment Variables
# ------------------------------------------------------------
CRON_SECRET=seu_cron_secret_aqui

# ------------------------------------------------------------
# APP — Configurações Gerais
# ------------------------------------------------------------
# E-mail do remetente das notificações (precisa de permissão Mail.Send no Azure AD)
ADMIN_EMAIL=administradora@dominio.com.br

# Timezone para exibição (não altera o cron, que roda em UTC)
TZ=America/Sao_Paulo
